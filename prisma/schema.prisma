generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum UserRole {
  USER // General user
  JOB_SEEKER // Looking for jobs
  EMPLOYER // Posting jobs
  SERVICE_PROVIDER // Offering services
  BUSINESS_OWNER // Restaurant, Shop, Health center owner
  WRITER // Writer's corner contributor
  EVENT_ORGANIZER // Organizing events
  CHARITY_ORG // Charity organization
  VOLUNTEER // Volunteer for charity
  PRAYER_PLACE_ADMIN // Managing prayer places
  MATRIMONY_SEEKER // Looking for marriage
  ADMIN // Platform admin
  SUPER_ADMIN // Super admin
}

// ==================== ENUMS for JOB====================

enum JobType {
  REMOTE
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum CompanyType {
  JOB_AGENCY
  RESTAURANT
  RETAIL_SHOP
  HEALTH_CLINIC
  NGO
  MEDIA
  OTHER
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_PLUS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ==================== ENUMS for BIODATA====================

enum GenderForBiodata {
  MALE
  FEMALE
  OTHER
}

enum ProfileFor {
  MYSELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  NEPHEW
  NIECE
  FRIEND
  OTHER
}

enum MaritalStatus {
  SINGLE
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  SEPARATED
}

enum Religion {
  HINDUISM
  ISLAM
  CHRISTIANITY
  SIKHISM
  BUDDHISM
  JUDAISM
  JAINISM
  SHINTO
  TAOISM
  ZOROASTRIANISM
  BAHAI_FAITH
  CONFUCIANISM
  ANIMISM
  PAGANISM
  RASTAFARIANISM
}

enum VisaStatus {
  CITIZEN
  LEGAL_PERMANENT_RESIDENT
  WORK_VISA
  STUDENT_VISA
  VISITOR_VISA
  OTHER
}

enum YesNo {
  YES
  NO
}

enum CoveringOption {
  YES
  NO
  SOMETIMES
}

enum BeardOption {
  YES
  NO
  TRIMMIED
}

enum SmokeOption {
  DO_NOT_SMOKE
  OCCASIONALLY
  SOCIAL_SMOKER
  REGULAR_SMOKER
  TRYING_TO_QUIT
}

enum DrinkOption {
  DO_NOT_DRINK
  OCCASIONAL_DRINKER
  SOCIAL_DRINKER
  REGULAR_DRINKER
}

enum DietType {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  EGGETARIAN
  PESCATARIAN
  OTHER
}

enum Complexion {
  VERY_FAIR
  FAIR
  LIGHT
  LIGHT_BROWN
  WHEATISH
  WHEATISH_BROWN
  MEDIUM_BROWN
  BROWN
  DARK_BROWN
  DARK
  OLIVE
  DUSKY
  EBONY
  CARAMEL
  HONEY
  COPPER
  BRONZE
}

enum FinancialStatus {
  POOR
  LOWER_MIDDLE
  MIDDLE_CLASS
  UPPER_MIDDLE
  AFFLUENT
  WEALTHY
}

enum ContactVisibility {
  VISIBLE_TO_EVERYONE
  PAID_MEMBERS_ONLY
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
// ==================== MODELS====================

model User {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phone       String?
  role        UserRole  @default(USER)
  avatar      String?
  bio         String?   @db.Text
  dateOfBirth DateTime?
  gender      Gender?

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("Bangladesh")

  // Verification
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Preferences
  // language String? @default("en")
  // currency String? @default("BDT")
  // timezone String? @default("Asia/Dhaka")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Matrimony specific fields
  biodata     Biodata?  

  shortlists Shortlist[] @relation("UserShortlist")

  // ============================================
  // RELATIONS - As Service Provider
  // ============================================
  companies      Company[] @relation("UserCompany") // Team member of company
  ownedCompanies Company[] @relation("CompanyOwner") // Owner of companies
  postedJobs     Job[]     @relation("JobPoster")
  // ownedRestaurants Restaurant[]      @relation("RestaurantOwner")
  // soldProducts     Product[]         @relation("ProductSeller")
  // healthProviders  HealthProvider[]  @relation("ProviderUser")
  // writtenBlogs     Blog[]            @relation("BlogAuthor")

  // ============================================
  // RELATIONS - As Normal User/Customer
  // ============================================
  jobApplications JobApplication[] @relation("JobApplicant")
  // customerOrders   Order[]           @relation("OrderCustomer")
  // shoppingCart     CartItem[]        @relation("UserCart")
  // wishlist         Wishlist[]        @relation("UserWishlist")
  // appointments     Appointment[]     @relation("PatientAppointments")
  // donations        Donation[]        @relation("Donor")
  // volunteerRecords VolunteerRecord[] @relation("Volunteer")

  // ============================================
  // INTERACTIONS - Reviews, Comments, etc.
  // ============================================
  // reviews          Review[]          @relation("ReviewAuthor")
  // blogComments     BlogComment[]     @relation("CommentAuthor")
  // notifications    Notification[]    @relation("UserNotifications")

  // ============================================
  // SAVED ITEMS
  // ============================================
  savedJobs SavedJob[] @relation("UserSavedJobs")

  // savedRestaurants SavedRestaurant[] @relation("UserSavedRestaurants")
  @@index([email])
  @@index([role])
  @@map("users")
}

model Company {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  logo        String?
  coverImage  String?
  description String?     @db.Text
  type        CompanyType

  // Contact Info
  email    String?
  phone    String?
  website  String?
  linkedIn String?
  facebook String?

  // Business Info
  industry String?
  size     CompanySize?
  founded  Int?
  tagline  String?

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("Bangladesh")

  // Verification
  // verificationStatus VerificationStatus @default(PENDING)
  verifiedAt DateTime?

  // Ratings
  rating       Float? @default(0)
  totalReviews Int    @default(0)

  // Ownership
  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Team Members
  teamMembers User[] @relation("UserCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations based on company type
  jobs Job[] @relation("CompanyJobs")
  // restaurants     Restaurant[]     @relation("CompanyRestaurants")
  // products        Product[]        @relation("CompanyProducts")
  // healthProviders HealthProvider[] @relation("CompanyHealthProviders")
  // ngoProjects     NgoProject[]     @relation("CompanyNgoProjects")

  @@index([slug])
  @@index([type])
  @@index([city])
  @@map("companies")
}

model Job {
  id               String  @id @default(uuid())
  title            String
  slug             String  @unique
  description      String  @db.Text
  requirements     String  @db.Text
  responsibilities String? @db.Text
  category         String?

  jobType    JobType  @default(FULL_TIME)
  experience String?
  education  String?
  skills     String[]

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?  @default("BDT")
  benefits       String[]

  location String
  city     String?

  applicationDeadline DateTime?
  totalPositions      Int?      @default(1)
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)

  metaTitle       String?
  metaDescription String?

  views             Int @default(0)
  applicationsCount Int @default(0)

  companyId String?
  company   Company? @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Cascade)

  posterId String
  poster   User   @relation("JobPoster", fields: [posterId], references: [id])

  applications JobApplication[] @relation("JobApplications")
  savedJobs    SavedJob[]       @relation("JobSavedJobs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobType])
  @@index([isActive])
  @@map("jobs")
}

// Placeholder models (you'll create these later)
model JobApplication {
  id             String            @id @default(uuid())
  status         ApplicationStatus @default(PENDING)
  coverLetter    String?           @db.Text
  resume         String? // File path
  portfolio      String? // URL
  expectedSalary Int?
  availableFrom  DateTime?

  // Admin notes
  adminNotes String?   @db.Text
  reviewedAt DateTime?
  reviewedBy String?

  jobId String
  job   Job    @relation("JobApplications", fields: [jobId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   User   @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

model SavedJob {
  id String @id @default(uuid())

  // foreign key to user (jobseeker)
  userId String
  user   User   @relation("UserSavedJobs", fields: [userId], references: [id], onDelete: Cascade)

  // foreign key to job
  jobId String
  job   Job    @relation("JobSavedJobs", fields: [jobId], references: [id], onDelete: Cascade)

  // Timestamps 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

// ─────────────────────────────
// BIODATA MODEL
// ─────────────────────────────

model Biodata {
  id        String   @id @default(cuid())
  customId  String? @unique // Custom ID like "M1234" or "F5678"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─────────────────────────────
  // STEP 1 — BASIC INFO
  // ─────────────────────────────
  firstName      String?
  lastName       String?
  gender         GenderForBiodata?
  profileFor     ProfileFor?
  maritalStatus  MaritalStatus?
  birthMonth     String?
  birthDay       String?
  birthYear      String?
  religion       Religion?
  educationLevel String?
  country        String?
  email          String?

  // ─────────────────────────────
  // STEP 2 — LOCATION
  // ─────────────────────────────
  city             String?
  nationality      String?
  placeOfBirth     String?
  visaStatus       VisaStatus?
  livingWithFamily YesNo?
  familyCountry    String?
  familyCity       String?

  // ─────────────────────────────
  // STEP 3 — APPEARANCE
  // ─────────────────────────────
  height     String?
  weight     String?
  complexion Complexion?
  diet       DietType?
  drink      DrinkOption?
  smoke      SmokeOption?
  hijab      CoveringOption?
  niqab      CoveringOption?
  beard      BeardOption?
  languages  String[] // multi select from JSON.languages
  skills     String[] // multi select from JSON.skills

  // ─────────────────────────────
  // STEP 4 — EDUCATION
  // ─────────────────────────────
  fieldOfStudy        String? // select from JSON.field_of_Study
  institution         String?
  graduationYear      String?
  otherQualifications String?

  // ─────────────────────────────
  // STEP 5 — CAREER
  // ─────────────────────────────
  occupation            String? // select from JSON.professions
  professionDescription String?
  monthlyIncome         String? // select from JSON.income_ranges

  // ─────────────────────────────
  // STEP 6 — FAMILY
  // ─────────────────────────────
  fatherName         String?
  fatherAlive        YesNo?
  fatherProfession   String? // select from JSON.professions
  motherName         String?
  motherAlive        YesNo?
  motherProfession   String? // select from JSON.professions
  brothersCount      String?
  sistersCount       String?
  financialStatus    FinancialStatus?
  religiousCondition String?

  // ─────────────────────────────
  // STEP 7 — PARTNER PREFERENCES
  // ─────────────────────────────
  partnerAgeMin        Int?
  partnerAgeMax        Int?
  partnerComplexion    Complexion?
  partnerHeight        String?
  partnerMaritalStatus MaritalStatus?
  partnerReligion      Religion?
  partnerEducation     String? // select from JSON.field_of_Study
  partnerProfession    String[] // multi select from JSON.professions
  partnerCountries     String[] // multi select from JSON.countries
  partnerDrink         DrinkOption?
  partnerSmoke         SmokeOption?
  partnerResidency     String?
  partnerExpectations  String?

  // ─────────────────────────────
  // STEP 8 — CONTACT
  // ─────────────────────────────
  contactName       String?
  phone             String?
  contactEmail      String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?
  contactVisibility ContactVisibility?

  // ─────────────────────────────
  // STEP 9 — DECLARATION
  // ─────────────────────────────
  truthPledge        Boolean @default(false)
  parentConsent      Boolean @default(false)
  falseInfoAgreement Boolean @default(false)

  //Interests sent and received
  sentInterests     Interest[] @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")

  // Optional: track progress
  lastCompletedStep Int?
  user              User  @relation(fields: [userId], references: [id])
  userId            String @unique

  shortlistedBy Shortlist[] @relation("ShortlistedBiodata")
}

model Interest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderBiodataId   String
  receiverBiodataId String
  message           String?
  status            InterestStatus @default(PENDING)

  senderBiodata   Biodata @relation("SentInterests", fields: [senderBiodataId], references: [id])
  receiverBiodata Biodata @relation("ReceivedInterests", fields: [receiverBiodataId], references: [id])

  @@unique([senderBiodataId, receiverBiodataId])
}

model Shortlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation("UserShortlist",      fields: [userId],    references: [id], onDelete: Cascade)

  biodataId String
  biodata   Biodata @relation("ShortlistedBiodata", fields: [biodataId], references: [id], onDelete: Cascade)

  @@unique([userId, biodataId])
  @@index([userId])
  @@index([biodataId])
  @@map("shortlists")
}

