generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  JOB_AGENCY
  RESTAURANT
  RETAIL_SHOP
  HEALTH_CLINIC
  NGO
  MEDIA
  OTHER
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_PLUS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ==================== ENUMS ====================
enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum UserRole {
  USER // General user
  JOB_SEEKER // Looking for jobs
  EMPLOYER // Posting jobs
  SERVICE_PROVIDER // Offering services
  BUSINESS_OWNER // Restaurant, Shop, Health center owner
  WRITER // Writer's corner contributor
  EVENT_ORGANIZER // Organizing events
  CHARITY_ORG // Charity organization
  VOLUNTEER // Volunteer for charity
  PRAYER_PLACE_ADMIN // Managing prayer places
  MATRIMONY_SEEKER // Looking for marriage
  ADMIN // Platform admin
  SUPER_ADMIN // Super admin
}

enum JobType {
  REMOTE
  FULL_TIME
  PART_TIME
  INTERSHIP
  CONTRACT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

