model User {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phone       String?
  role        UserRole  @default(USER)
  avatar      String?
  bio         String?   @db.Text
  dateOfBirth DateTime?
  gender      Gender?

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("Bangladesh")

  // Verification
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Preferences
  // language String? @default("en")
  // currency String? @default("BDT")
  // timezone String? @default("Asia/Dhaka")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // ============================================
  // RELATIONS - As Service Provider
  // ============================================
  companies      Company[] @relation("UserCompany") // Team member of company
  ownedCompanies Company[] @relation("CompanyOwner") // Owner of companies
  postedJobs     Job[]     @relation("JobPoster")
  // ownedRestaurants Restaurant[]      @relation("RestaurantOwner")
  // soldProducts     Product[]         @relation("ProductSeller")
  // healthProviders  HealthProvider[]  @relation("ProviderUser")
  // writtenBlogs     Blog[]            @relation("BlogAuthor")

  // ============================================
  // RELATIONS - As Normal User/Customer
  // ============================================
  jobApplications JobApplication[] @relation("JobApplicant")
  // customerOrders   Order[]           @relation("OrderCustomer")
  // shoppingCart     CartItem[]        @relation("UserCart")
  // wishlist         Wishlist[]        @relation("UserWishlist")
  // appointments     Appointment[]     @relation("PatientAppointments")
  // donations        Donation[]        @relation("Donor")
  // volunteerRecords VolunteerRecord[] @relation("Volunteer")

  // ============================================
  // INTERACTIONS - Reviews, Comments, etc.
  // ============================================
  // reviews          Review[]          @relation("ReviewAuthor")
  // blogComments     BlogComment[]     @relation("CommentAuthor")
  // notifications    Notification[]    @relation("UserNotifications")

  // ============================================
  // SAVED ITEMS
  // ============================================
  savedJobs SavedJob[] @relation("UserSavedJobs")

  // savedRestaurants SavedRestaurant[] @relation("UserSavedRestaurants")
  @@index([email])
  @@index([role])
  @@map("users")
}

model Company {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  logo        String?
  coverImage  String?
  description String?     @db.Text
  type        CompanyType

  // Contact Info
  email    String?
  phone    String?
  website  String?
  linkedIn String?
  facebook String?

  // Business Info
  industry String?
  size     CompanySize?
  founded  Int?
  tagline  String?

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?
  country String? @default("Bangladesh")

  // Verification
  // verificationStatus VerificationStatus @default(PENDING)
  verifiedAt DateTime?

  // Ratings
  rating       Float? @default(0)
  totalReviews Int    @default(0)

  // Ownership
  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Team Members
  teamMembers User[] @relation("UserCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations based on company type
  jobs Job[] @relation("CompanyJobs")
  // restaurants     Restaurant[]     @relation("CompanyRestaurants")
  // products        Product[]        @relation("CompanyProducts")
  // healthProviders HealthProvider[] @relation("CompanyHealthProviders")
  // ngoProjects     NgoProject[]     @relation("CompanyNgoProjects")

  @@index([slug])
  @@index([type])
  @@index([city])
  @@map("companies")
}

model Job {
  id               String  @id @default(uuid())
  title            String
  slug             String  @unique
  description      String  @db.Text
  requirements     String  @db.Text
  responsibilities String? @db.Text
  category         String?

  jobType    JobType  @default(FULL_TIME)
  experience String?
  education  String?
  skills     String[]

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?  @default("BDT")
  benefits       String[]

  location String
  city     String?

  applicationDeadline DateTime?
  totalPositions      Int?      @default(1)
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)

  metaTitle       String?
  metaDescription String?

  views             Int @default(0)
  applicationsCount Int @default(0)

  companyId String?
  company   Company? @relation("CompanyJobs", fields: [companyId], references: [id], onDelete: Cascade)

  posterId String
  poster   User   @relation("JobPoster", fields: [posterId], references: [id])

  applications JobApplication[] @relation("JobApplications")
  savedJobs    SavedJob[]       @relation("JobSavedJobs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobType])
  @@index([isActive])
  @@map("jobs")
}

// Placeholder models (you'll create these later)
model JobApplication {
  id             String            @id @default(uuid())
  status         ApplicationStatus @default(PENDING)
  coverLetter    String?           @db.Text
  resume         String? // File path
  portfolio      String? // URL
  expectedSalary Int?
  availableFrom  DateTime?

  // Admin notes
  adminNotes String?   @db.Text
  reviewedAt DateTime?
  reviewedBy String?

  jobId String
  job   Job    @relation("JobApplications", fields: [jobId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   User   @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

model SavedJob {
  id String @id @default(uuid())

  // foreign key to user (jobseeker)
  userId String
  user   User   @relation("UserSavedJobs", fields: [userId], references: [id], onDelete: Cascade)

  // foreign key to job
  jobId String
  job   Job    @relation("JobSavedJobs", fields: [jobId], references: [id], onDelete: Cascade)

  // Timestamps 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}
